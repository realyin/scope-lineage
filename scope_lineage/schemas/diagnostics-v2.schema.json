{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskStateLineageDiagnostics",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "analysis_status",
    "warnings",
    "stats",
    "lineage_fact_gaps",
    "statement_diagnostics"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string", "minLength": 1},
    "analysis_status": {
      "type": "object",
      "required": ["status", "blocking_reasons"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "scope", "msg"]
      }
    },
    "stats": {"type": "object"},
    "lineage_fact_gaps": {
      "type": "array",
      "items": {"type": "object"}
    },
    "statement_diagnostics": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    }
  }
}
