{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "catalog-yaml/1 constraints",
  "type": "object",
  "required": [
    "constraints"
  ],
  "additionalProperties": false,
  "properties": {
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
    },
    "status": {
      "enum": [
        "drafted",
        "confirmed",
        "deprecated"
      ]
    },
    "source": {
      "enum": [
        "owner",
        "comment",
        "task",
        "sql",
        "llm",
        "mixed"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "on",
        "expression",
        "strength"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "enum": [
            "unique",
            "cardinality",
            "mandatory",
            "value_domain",
            "referential",
            "temporal",
            "state_transition",
            "derivation",
            "business_rule"
          ]
        },
        "on": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "rules": {
          "description": "The table-semantics rules this constraint carries, each <db.table>#<rule id>",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+#r[0-9]+$"
          }
        },
        "predicate": {
          "description": "The constraint as one column condition: column op value (in / not_in take a list, is_null / not_null no value)",
          "type": "object",
          "required": [
            "column",
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "enum": [
                "=",
                "!=",
                "<",
                "<=",
                ">",
                ">=",
                "in",
                "not_in",
                "is_null",
                "not_null",
                "like"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "op": {
                    "enum": [
                      "is_null",
                      "not_null"
                    ]
                  }
                },
                "required": [
                  "op"
                ]
              },
              "then": {
                "properties": {
                  "value": false
                }
              },
              "else": {
                "required": [
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "enum": [
                      "in",
                      "not_in"
                    ]
                  }
                },
                "required": [
                  "op"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "array"
                  }
                }
              },
              "else": {
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              }
            }
          ]
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      }
    }
  }
}
