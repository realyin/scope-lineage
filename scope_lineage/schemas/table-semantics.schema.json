{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "table-semantics/1",
  "description": "What one target table means, written for people over a deterministic material packet. The shape is checked here; agreement with the packet is `semantic validate`'s cross checks, which also own the counts (non-empty sources, at most eight questions).",
  "type": "object",
  "required": ["doc_format", "table", "packet_digest", "summary", "columns", "steps", "rules"],
  "additionalProperties": false,
  "oneOf": [
    {"required": ["task"], "not": {"required": ["tasks"]}},
    {"required": ["tasks"], "not": {"required": ["task"]}}
  ],
  "properties": {
    "doc_format": {"const": "table-semantics/1"},
    "table": {"$ref": "#/definitions/table"},
    "packet_digest": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "model": {"type": "string"}
      }
    },
    "summary": {"$ref": "#/definitions/summary"},
    "columns": {"type": "array", "items": {"$ref": "#/definitions/column"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {"type": "string", "minLength": 1}
    },
    "rules": {"type": "array", "items": {"$ref": "#/definitions/rule"}},
    "task": {"$ref": "#/definitions/task"},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/task"}},
    "concept": {
      "type": "object",
      "required": ["concept"],
      "additionalProperties": false,
      "properties": {
        "concept": {"type": "string", "pattern": "^concept:[a-z0-9_.]+$"},
        "representation_kind": {"type": "string"}
      }
    },
    "confirmed": {
      "description": "Written by `semantic confirm`: every confirmation applied to this document, in order. An `input:<db.table>` record names its table without a catalog prefix and carries `columns`, the observed columns in lower case and name order: one input table observed on two sets of columns is two records.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "by", "date"],
        "additionalProperties": false,
        "properties": {
          "target": {"type": "string"},
          "by": {"type": "string"},
          "date": {"type": "string"},
          "columns": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "observed_inputs": {
      "description": "Written by `semantic confirm` from `input:<db.table>` confirmations, never by a writer: what a platform query found about an input table this table reads, under this table's own read conditions. One item per input table and set of columns, a later observation replacing an earlier one. An observation, not a definition: it says nothing about other partitions or other target tables.",
      "type": "array",
      "items": {"$ref": "#/definitions/observed_input"}
    }
  },
  "definitions": {
    "table": {"type": "string", "pattern": "^[^.\\s]+\\.[^.\\s]+$"},
    "text": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {"enum": ["comment", "sql", "sql_comment", "metadata", "task", "inferred", "confirmed"]}
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "summary": {
      "type": "object",
      "required": ["what", "row", "refresh", "scope", "upstream", "downstream", "good_for", "not_for", "watch", "questions"],
      "additionalProperties": false,
      "properties": {
        "what": {"$ref": "#/definitions/text"},
        "row": {"$ref": "#/definitions/row"},
        "refresh": {"$ref": "#/definitions/refresh"},
        "scope": {"type": "array", "items": {"$ref": "#/definitions/scope"}},
        "upstream": {"type": "array", "items": {"$ref": "#/definitions/upstream"}},
        "downstream": {"type": "array", "items": {"$ref": "#/definitions/downstream"}},
        "good_for": {"type": "array", "items": {"$ref": "#/definitions/text"}},
        "not_for": {"type": "array", "items": {"$ref": "#/definitions/text"}},
        "watch": {"type": "array", "items": {"$ref": "#/definitions/watch"}},
        "questions": {"type": "array", "items": {"$ref": "#/definitions/question"}}
      }
    },
    "row": {
      "type": "object",
      "required": ["text", "grain_columns", "grain_source", "unique", "sources"],
      "additionalProperties": false,
      "properties": {
        "text": {"$ref": "#/definitions/text"},
        "grain_columns": {"type": "array", "items": {"$ref": "#/definitions/text"}},
        "grain_source": {
          "description": "`proven`: the lineage proves the key; `declared`: a comment or the owner says so; `observed`: a platform query found it (`observed` holds the query, the partitions and the date); `inferred`: read from the SQL. Ranked in this order.",
          "enum": ["declared", "inferred", "proven", "observed"]
        },
        "unique": {
          "description": "Whether a row is unique by `grain_columns`. When `grain_source` is `observed` it speaks only of the observed partitions.",
          "enum": ["yes", "no", "unknown"]
        },
        "note": {"type": "string"},
        "sources": {"$ref": "#/definitions/sources"},
        "confidence": {"$ref": "#/definitions/confidence"},
        "watch": {"type": "string"},
        "observed": {
          "description": "Written by `semantic confirm` from a `summary.row.observed` confirmation, never by a writer.",
          "$ref": "#/definitions/observed_grain"
        }
      }
    },
    "refresh": {
      "type": "object",
      "required": ["cycle", "time", "how_to_read", "sources"],
      "additionalProperties": false,
      "properties": {
        "cycle": {"$ref": "#/definitions/text"},
        "time": {"enum": ["snapshot", "incremental", "zipper", "unknown"]},
        "how_to_read": {"$ref": "#/definitions/text"},
        "sources": {"$ref": "#/definitions/sources"},
        "confidence": {"$ref": "#/definitions/confidence"},
        "watch": {"type": "string"}
      }
    },
    "scope": {
      "type": "object",
      "required": ["text", "sources"],
      "additionalProperties": false,
      "properties": {
        "text": {"$ref": "#/definitions/text"},
        "rule_refs": {"type": "array", "items": {"type": "string"}},
        "sources": {"$ref": "#/definitions/sources"},
        "confidence": {"$ref": "#/definitions/confidence"},
        "watch": {"type": "string"}
      }
    },
    "upstream": {
      "type": "object",
      "required": ["table", "role", "provides", "sources"],
      "additionalProperties": false,
      "properties": {
        "table": {"type": "string", "minLength": 1},
        "role": {"enum": ["main", "enrich", "filter", "dedup", "union_branch", "lookup", "other"]},
        "provides": {"$ref": "#/definitions/text"},
        "sources": {"$ref": "#/definitions/sources"},
        "confidence": {"$ref": "#/definitions/confidence"},
        "watch": {"type": "string"}
      }
    },
    "downstream": {
      "type": "object",
      "required": ["task"],
      "additionalProperties": false,
      "properties": {
        "task": {"$ref": "#/definitions/text"},
        "table": {"type": "string", "minLength": 1}
      }
    },
    "watch": {
      "type": "object",
      "required": ["text", "kind"],
      "additionalProperties": false,
      "properties": {
        "text": {"$ref": "#/definitions/text"},
        "kind": {"enum": ["conflict", "risk", "deprecated", "coverage", "other"]},
        "refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "text", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^q[0-9]+$"},
        "text": {"$ref": "#/definitions/text"},
        "about": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["open", "answered"]},
        "answer": {"type": "string"},
        "answered_by": {"type": "string"},
        "answered_on": {"type": "string"}
      }
    },
    "column": {
      "type": "object",
      "required": ["column", "meaning", "category", "derivation", "sources", "confidence"],
      "additionalProperties": false,
      "properties": {
        "column": {"$ref": "#/definitions/text"},
        "meaning": {"$ref": "#/definitions/text"},
        "category": {"enum": ["identifier", "foreign_identifier", "descriptive", "state", "measure", "time", "technical"]},
        "derivation": {"type": "string"},
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["branch", "text"],
            "additionalProperties": false,
            "properties": {
              "branch": {"$ref": "#/definitions/text"},
              "text": {"$ref": "#/definitions/text"}
            }
          }
        },
        "source_columns": {"type": "array", "items": {"type": "string", "pattern": "^[^.\\s]+(\\.[^.\\s]+){2,3}$"}},
        "code_values": {"type": "array", "items": {"$ref": "#/definitions/code_value"}},
        "observed_values": {
          "description": "Written by `semantic confirm` from a `column:<c>.observed_values` confirmation, never by a writer: the values a platform query found. Not code values -- a value seen says nothing of what it means.",
          "$ref": "#/definitions/observed_values"
        },
        "unit": {"type": "string"},
        "null_meaning": {"type": "string"},
        "watch": {"type": "string"},
        "sources": {"$ref": "#/definitions/sources"},
        "confidence": {"$ref": "#/definitions/confidence"}
      }
    },
    "code_value": {
      "type": "object",
      "required": ["value", "meaning", "sources"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "string"},
        "meaning": {"$ref": "#/definitions/text"},
        "sources": {"$ref": "#/definitions/sources"},
        "unconfirmed": {"type": "boolean"}
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "kind", "text", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^r[0-9]+$"},
        "kind": {"enum": ["filter", "join", "dedup", "derive", "union", "other"]},
        "text": {"$ref": "#/definitions/text"},
        "sql": {"type": "string", "minLength": 1},
        "sources": {"$ref": "#/definitions/sources"},
        "confidence": {"$ref": "#/definitions/confidence"},
        "watch": {"type": "string"}
      }
    },
    "observation": {
      "description": "What one platform query observed and where: the query's id, the date it ran, the partitions it read (a fallback to the latest available one names the partition first asked for in `requested`), its own read condition and how many rows it saw (at least 1: an empty table proves nothing). Counts and at most 50 values only -- never detail rows. An observation is not a definition: it speaks of these partitions on this date.",
      "type": "object",
      "required": ["query", "on", "rows", "partition"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "rows": {"type": "integer", "minimum": 1},
        "partition": {"$ref": "#/definitions/observed_partition"},
        "requested": {"type": "string", "minLength": 1},
        "filter": {"type": "string", "minLength": 1, "maxLength": 200},
        "engine": {"type": "string", "minLength": 1}
      }
    },
    "observed_partition": {
      "description": "The partitions read: `values`, or a range `from`..`to` holding `count` partitions; `column` null for an unpartitioned table or the whole table.",
      "type": "object",
      "required": ["column"],
      "additionalProperties": false,
      "properties": {
        "column": {"type": ["string", "null"], "minLength": 1},
        "values": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1}
      },
      "dependencies": {"from": ["to"], "to": ["from"]}
    },
    "observed_unique": {"enum": ["yes", "no"]},
    "observed_within": {
      "description": "`each_partition`: counted inside each partition; `all_observed`: across all the observed partitions together.",
      "enum": ["each_partition", "all_observed"]
    },
    "observed_count": {"type": "integer", "minimum": 0},
    "observed_value": {"type": "string", "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
    "observed_grain": {
      "description": "An observation of the row's uniqueness. `grain_columns` are the columns the query counted, which need not be the document's grain columns.",
      "allOf": [{"$ref": "#/definitions/observation"}],
      "required": ["grain_columns", "unique", "within"],
      "properties": {
        "grain_columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}},
        "unique": {"$ref": "#/definitions/observed_unique"},
        "within": {"$ref": "#/definitions/observed_within"},
        "keys": {"$ref": "#/definitions/observed_count"},
        "duplicate_keys": {"$ref": "#/definitions/observed_count"}
      },
      "propertyNames": {"enum": ["query", "on", "rows", "partition", "requested", "filter", "engine",
                                 "grain_columns", "unique", "within", "keys", "duplicate_keys"]}
    },
    "observed_values": {
      "description": "An observation of a column's values: at most 50 distinct values with their counts (`complete` when the query returned all of them), values asked about and not seen (`absent`), and counts. An identifier column carries counts only. `observed_on` names the source column observed when the query read it rather than this column (one of `source_columns`).",
      "allOf": [{"$ref": "#/definitions/observation"}],
      "required": ["complete"],
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["value", "count"],
            "additionalProperties": false,
            "properties": {
              "value": {"$ref": "#/definitions/observed_value"},
              "count": {"$ref": "#/definitions/observed_count"}
            }
          }
        },
        "complete": {"type": "boolean"},
        "absent": {"type": "array", "maxItems": 50, "items": {"$ref": "#/definitions/observed_value"}},
        "distinct": {"$ref": "#/definitions/observed_count"},
        "nulls": {"$ref": "#/definitions/observed_count"},
        "observed_on": {"type": "string", "pattern": "^[^.\\s]+(\\.[^.\\s]+){2,3}$"}
      },
      "propertyNames": {"enum": ["query", "on", "rows", "partition", "requested", "filter", "engine",
                                 "values", "complete", "absent", "distinct", "nulls", "observed_on"]}
    },
    "observed_input": {
      "description": "An observation of an input table's uniqueness by `columns`, under the reading table's own conditions.",
      "allOf": [{"$ref": "#/definitions/observation"}],
      "required": ["table", "columns", "unique", "within"],
      "properties": {
        "table": {"$ref": "#/definitions/table"},
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/text"}},
        "unique": {"$ref": "#/definitions/observed_unique"},
        "within": {"$ref": "#/definitions/observed_within"},
        "keys": {"$ref": "#/definitions/observed_count"},
        "duplicate_keys": {"$ref": "#/definitions/observed_count"}
      },
      "propertyNames": {"enum": ["query", "on", "rows", "partition", "requested", "filter", "engine",
                                 "table", "columns", "unique", "within", "keys", "duplicate_keys"]}
    },
    "task": {
      "type": "object",
      "required": ["name", "purpose", "outputs"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/definitions/text"},
        "purpose": {"$ref": "#/definitions/text"},
        "cycle": {"type": "string"},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "upstream_tasks": {"type": "array", "items": {"type": "string"}},
        "downstream_tasks": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
