{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "semantic-confirmations/1",
  "description": "A person's answers to table-semantics documents, applied by `semantic confirm`. Each entry names one table and one target; the value's shape depends on the target and is checked when it is applied.",
  "type": "object",
  "required": ["doc_format", "confirmations"],
  "additionalProperties": false,
  "properties": {
    "doc_format": {"const": "semantic-confirmations/1"},
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "target", "value", "by", "date"],
        "additionalProperties": false,
        "properties": {
          "table": {"type": "string", "minLength": 1},
          "target": {
            "type": "string",
            "pattern": "^(question:q[0-9]+|column:[^.\\s]+\\.(meaning|code_values)|summary\\.row)$"
          },
          "value": {},
          "by": {"type": "string", "minLength": 1},
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  }
}
