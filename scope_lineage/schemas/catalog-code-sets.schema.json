{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "catalog-yaml/1 code sets",
  "type": "object",
  "required": [
    "code_sets"
  ],
  "additionalProperties": false,
  "properties": {
    "code_sets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
    },
    "status": {
      "enum": [
        "drafted",
        "confirmed",
        "deprecated"
      ]
    },
    "source": {
      "enum": [
        "owner",
        "comment",
        "task",
        "sql",
        "llm",
        "mixed"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "meaning"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "meaning": {
                "description": "Empty, or starting 待确认, while the meaning is not confirmed",
                "type": "string"
              },
              "retired": {
                "type": "boolean"
              },
              "unconfirmed": {
                "description": "The value is seen in the data but its meaning is not confirmed",
                "type": "boolean"
              }
            }
          }
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      }
    }
  }
}
