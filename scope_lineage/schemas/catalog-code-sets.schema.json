{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "catalog-yaml/1 code sets",
  "type": "object",
  "required": [
    "code_sets"
  ],
  "additionalProperties": false,
  "properties": {
    "code_sets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
    },
    "status": {
      "enum": [
        "drafted",
        "confirmed",
        "deprecated"
      ]
    },
    "source": {
      "enum": [
        "owner",
        "comment",
        "task",
        "sql",
        "llm",
        "mixed"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "meaning"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "meaning": {
                "description": "Empty, or starting 待确认, while the meaning is not confirmed",
                "type": "string"
              },
              "key": {
                "description": "The surrogate key an inline dictionary pairs with this code, when it has one",
                "type": [
                  "string",
                  "integer"
                ]
              },
              "retired": {
                "type": "boolean"
              },
              "unconfirmed": {
                "description": "The value is seen in the data but its meaning is not confirmed",
                "type": "boolean"
              }
            }
          }
        },
        "lookup": {
          "description": "Where the values live when they are not listed: a table, its code and meaning columns, and how this set's rows are picked out",
          "type": "object",
          "required": [
            "table",
            "code_column",
            "meaning_columns"
          ],
          "additionalProperties": false,
          "properties": {
            "table": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"
            },
            "code_column": {
              "description": "The column holding the code a translated column carries",
              "type": "string",
              "minLength": 1
            },
            "meaning_columns": {
              "description": "The columns holding what a code means, each with its language when known",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "column"
                ],
                "additionalProperties": false,
                "properties": {
                  "column": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lang": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "key_column": {
              "description": "The dictionary's surrogate key, when a fact table may carry it instead of the code",
              "type": "string",
              "minLength": 1
            },
            "filter": {
              "description": "Constant equality conditions that pick this code set's rows out of a table shared by several: column -> literal",
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "valid_from": {
              "description": "With valid_to: the columns bounding each row's validity window",
              "type": "string",
              "minLength": 1
            },
            "valid_to": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "valid_from": [
              "valid_to"
            ],
            "valid_to": [
              "valid_from"
            ]
          }
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      }
    }
  }
}
