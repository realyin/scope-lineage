{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "catalog-yaml/1 mapping",
  "type": "object",
  "required": [
    "representations"
  ],
  "additionalProperties": false,
  "properties": {
    "representations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
    },
    "status": {
      "enum": [
        "drafted",
        "confirmed",
        "deprecated"
      ]
    },
    "source": {
      "enum": [
        "owner",
        "comment",
        "task",
        "sql",
        "llm",
        "mixed"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "item": {
      "type": "object",
      "required": [
        "table",
        "concept",
        "kind",
        "grain",
        "time",
        "table_status",
        "bindings"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"
        },
        "concept": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
        },
        "kind": {
          "enum": [
            "core",
            "extension",
            "dependent",
            "event_detail",
            "state_history",
            "identifier_map",
            "role_view",
            "summary",
            "intermediate"
          ]
        },
        "grain": {
          "type": "object",
          "required": [
            "identifiers",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "identifiers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
              }
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "source": {
              "enum": [
                "declared",
                "inferred",
                "proven"
              ]
            }
          }
        },
        "time": {
          "enum": [
            "snapshot",
            "incremental",
            "zipper",
            "unknown"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "refresh": {
          "type": "string",
          "minLength": 1
        },
        "table_status": {
          "enum": [
            "active",
            "deprecated"
          ]
        },
        "replaced_by": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/binding"
          }
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "column",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "enum": [
            "attribute",
            "identifier",
            "foreign_identifier",
            "foreign_attribute",
            "technical",
            "unmapped"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
        },
        "via": {
          "description": "foreign_attribute only: the column of this table, bound as foreign_identifier, that names the instance whose attribute this column repeats",
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "description": "foreign_identifier only: the relation this column realises -- one end the table's concept, the other the concept its identifier names (for a column naming another instance of the table's own concept, a relation from that concept to itself)",
          "type": "string",
          "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        },
        "code_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_sets": {
          "description": "The code sets this column's values relate to, read as code_sets_by says (absent: in lookup order, look up in the first, then the next); holds says how the values relate to them (absent: they are the codes)",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*:[a-z0-9_.]+$"
          }
        },
        "code_sets_by": {
          "description": "How code_sets is read. lookup (the same as absent): a lookup order, look a value up in the first code set, then the next. source: each source or branch writing the column uses one of the code sets, its own; the order means nothing. Needs code_sets; source needs at least two",
          "enum": [
            "lookup",
            "source"
          ]
        },
        "holds": {
          "description": "What a value of this column is, in order of preference: the code, the meaning or the dictionary key of its code sets (code_sets, else the bound attribute's code_set); absent means [code]. More than one: a value is one of them, whether a lookup missed or a source wrote it that way",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "code",
              "meaning",
              "key"
            ]
          }
        },
        "lang": {
          "description": "holds with meaning only: the language of the stored meaning, as a lookup's meaning_columns[].lang names it",
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/definitions/status"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "to": {
                "enum": [
                  "attribute",
                  "identifier",
                  "foreign_identifier",
                  "foreign_attribute"
                ]
              }
            },
            "required": [
              "to"
            ]
          },
          "then": {
            "required": [
              "ref"
            ]
          },
          "else": {
            "properties": {
              "ref": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "to": {
                "const": "foreign_attribute"
              }
            },
            "required": [
              "to"
            ]
          },
          "then": {
            "required": [
              "via"
            ]
          },
          "else": {
            "properties": {
              "via": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "to": {
                "const": "foreign_identifier"
              }
            },
            "required": [
              "to"
            ]
          },
          "else": {
            "properties": {
              "relation": false
            }
          }
        }
      ]
    }
  }
}
