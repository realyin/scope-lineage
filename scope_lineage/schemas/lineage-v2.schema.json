{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskStateLineage",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "task_id",
    "parse_status",
    "syntax_status",
    "syntax_errors",
    "analysis_status",
    "statement_sequence",
    "table_state_graph",
    "final_table_states",
    "statement_lineage",
    "end_to_end_lineage",
    "task_dependencies",
    "diagnostics"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "artifact_kind": {
      "const": "task_lineage"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parse_status": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "syntax_status": {
      "enum": [
        "strict_ok",
        "recovered",
        "failed"
      ]
    },
    "syntax_errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "analysis_status": {
      "type": "object",
      "required": [
        "status",
        "blocking_reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "statement_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement_id",
          "statement_index",
          "stmt_kind",
          "category",
          "model_status",
          "normalized_sql"
        ],
        "additionalProperties": true,
        "properties": {
          "statement_id": {
            "type": "string",
            "pattern": "^stmt:[0-9]{3,}$"
          },
          "statement_index": {
            "type": "integer",
            "minimum": 0
          },
          "stmt_kind": {
            "type": "string"
          },
          "category": {
            "enum": [
              "projection_write",
              "conditional_write",
              "row_mutation",
              "control_statement",
              "empty_statement",
              "unsupported_statement"
            ]
          },
          "model_status": {
            "enum": [
              "modeled",
              "ignored",
              "unsupported",
              "failed"
            ]
          },
          "normalized_sql": {
            "type": "string"
          },
          "target_table": {
            "type": "string"
          },
          "input_states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_state": {
            "type": "string"
          },
          "effect": {
            "type": "object"
          },
          "is_session_scoped_relation": {
            "type": "boolean",
            "description": "仅在为 true 时出现。该语句产出的关系只存活于会话(TEMP VIEW / GLOBAL TEMP VIEW / CACHE [LAZY] TABLE),不会落到存储。`final_table_states` 会为脚本产出的每个关系建条目,消费者按 catalog 对账前应先用本字段排除这些关系,否则会认为仓库新增了并不存在的表。"
          }
        }
      }
    },
    "table_state_graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "state_id",
              "table",
              "ordinal",
              "known_empty",
              "columns_known",
              "producer_statement_id"
            ],
            "properties": {
              "state_id": {
                "type": "string"
              },
              "table": {
                "type": "string",
                "minLength": 1
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0
              },
              "known_empty": {
                "type": "boolean"
              },
              "columns_known": {
                "type": "boolean"
              },
              "producer_statement_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "statement_id",
              "effect"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "statement_id": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "final_table_states": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "statement_lineage": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "end_to_end_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_state",
          "table",
          "column",
          "value_sources",
          "row_membership_sources",
          "value_condition_sources",
          "trace_complete",
          "missing_reasons"
        ],
        "properties": {
          "target_state": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "column": {
            "type": "string"
          },
          "value_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_state": {
                  "type": "string",
                  "description": "可选。仅当来源表在本脚本中被某条语句写过时出现,给出这次读取看到的是该表的哪个状态(对应 table_state_graph.nodes[].state_id)。一张表在一个脚本里可以有多个状态,只按表名解析这一跳会折叠到「最后一个定义」而不是「当时读到的那个」。**若该 state_id 不在任何 end_to_end_lineage[].target_state 中,说明这一跳无法从本文档折叠**——end_to_end_lineage 是最终状态视图,中间状态不在其中。此时应保留原边,不要替换。"
                },
                "session_scoped": {
                  "type": "boolean",
                  "description": "可选,仅在为 true 时出现。这条边读的关系只存活于会话(TEMP VIEW / GLOBAL TEMP VIEW / CACHE [LAZY] TABLE / TEMPORARY TABLE),不会落到存储。与产出语句上的 is_session_scoped_relation 是同一事实,但直接标在边上,消费方不必回 statement_sequence 里做关联。**这不是 source_kind 的取值**:source_kind 保持原义,不认识本字段的过滤器行为不变。"
                }
              },
              "additionalProperties": true
            }
          },
          "window_context_sources": {
            "type": "array",
            "description": "Optional. The columns a window grouped or ordered by, and which role each played. Every one of them also appears in the value/physical sources, which stay the complete dependency set; this array only says which of them the window used as context rather than computed. Omitted when there is none.",
            "items": {
              "type": "object",
              "required": [
                "table",
                "column",
                "role"
              ],
              "properties": {
                "table": {
                  "type": "string"
                },
                "column": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "partition",
                    "order"
                  ]
                }
              }
            }
          },
          "row_membership_sources": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "value_condition_sources": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "trace_complete": {
            "type": "boolean"
          },
          "missing_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "task_dependencies": {
      "type": "object"
    },
    "diagnostics": {
      "type": "object"
    }
  }
}
