sl:ods_channel_eventShape
    a sh:NodeShape ;
    sh:targetClass sl:ods_channel_event ;
    rdfs:label "ods.channel_event" ;
    rdfs:comment "渠道事件明细（合成）" ;
    sl:domain "渠道域" ;
    sl:project "渠道分析（合成）" ;
    sl:owner "demo_owner" ;
    sl:represents "concept:channel (reference)" ;
    sl:represents "concept:table:ods_channel_event (primary)" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:customer_id ;
        sh:name "customer_id" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:channel_code ;
        sh:name "channel_code" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:amount ;
        sh:name "amount" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:status ;
        sh:name "status" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:status ;
        rdfs:comment "in_set (hypothesis) on status; observed values: ACTIVE; the SQL did not prove the set closed" ;
        sl:constraint "cst:006" ;
        sl:tier "hypothesis"
    ] ;
    sh:property [
        sh:path sl:rel_001 ;
        sh:class sl:dim_channel ;
        sh:maxCount 1 ;
        sl:relation "rel:001" ;
        sl:evidenceFor "crel:001" ;
        sl:claim "many_to_one_assumed" ;
        sl:taskCount 2 ;
        sl:evidenceCount 2 ;
        sl:evidenceTask "golden_commented_insert" ;
        sl:tier "hypothesis"
    ] ;
    sl:multiplicity [
        sl:column "customer_id, channel_code" ;
        rdfs:comment "multiple_rows_per_key (implied) on customer_id, channel_code; evidence_count 2, first task golden_commented_insert" ;
        sl:tier "implied"
    ] .

