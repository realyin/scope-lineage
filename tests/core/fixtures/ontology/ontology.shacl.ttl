        sh:path sl:total ;
        sh:name "total" ;
        sh:datatype xsd:decimal ;
        rdfs:comment "Summed amount" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:cnt ;
        sh:name "cnt" ;
        sh:datatype xsd:integer ;
        rdfs:comment "Row count" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:band_total ;
        sh:name "band_total" ;
