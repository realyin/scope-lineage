    rdfs:label "mart.user_names" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:user_id ;
        sh:name "user_id" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:user_name ;
        sh:name "user_name" ;
