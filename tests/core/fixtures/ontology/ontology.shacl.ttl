@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sl: <https://example.org/scope-lineage/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Exported from an ontology candidate over a SQL corpus. The base IRI is a placeholder;
# every shape carries sl:tier for the assertion it came from -- read it before validating.

sl:dim_channelShape
    a sh:NodeShape ;
    sh:targetClass sl:dim_channel ;
    rdfs:label "dim.channel" ;
    rdfs:comment "渠道维表（合成）" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:channel_code ;
        sh:name "channel_code" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:channel_name ;
        sh:name "channel_name" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sl:candidateKey [
        sl:keyColumn "channel_code" ;
        rdfs:comment "candidate key; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:tier "hypothesis"
    ] .

sl:dim_segment_dimShape
    a sh:NodeShape ;
    sh:targetClass sl:dim_segment_dim ;
    rdfs:label "dim.segment_dim" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:segment ;
        sh:name "segment" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:segment_name ;
        sh:name "segment_name" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:updated_at ;
        sh:name "updated_at" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] .

sl:mart_channel_summaryShape
    a sh:NodeShape ;
    sh:targetClass sl:mart_channel_summary ;
    rdfs:label "mart.channel_summary" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:customer_id ;
        sh:name "customer_id" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:channel_name ;
        sh:name "channel_name" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:total_amount ;
        sh:name "total_amount" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:channel_name ;
        sh:in ( "OFFLINE" "ONLINE" ) ;
        rdfs:comment "in_set (proven) on channel_name; observed values: OFFLINE, ONLINE" ;
        sl:constraint "cst:002" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:dt ;
        rdfs:comment "partition (proven) on dt" ;
        sl:constraint "cst:003" ;
        sl:tier "proven"
    ] ;
    sl:compositeKey [
        sl:constraint "cst:001" ;
        sl:keyColumn "customer_id", "channel_name", "dt" ;
        rdfs:comment "unique_per (proven) on customer_id, channel_name, dt; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:tier "proven"
    ] ;
    sl:candidateKey [
        sl:keyColumn "customer_id", "channel_name" ;
        rdfs:comment "candidate key; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:tier "proven"
    ] .

sl:mart_metric_by_segmentShape
    a sh:NodeShape ;
    sh:targetClass sl:mart_metric_by_segment ;
    rdfs:label "mart.metric_by_segment" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:segment ;
        sh:name "segment" ;
        sh:datatype xsd:string ;
        rdfs:comment "Segment code" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:band ;
        sh:name "band" ;
        sh:datatype xsd:string ;
        rdfs:comment "Amount band" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:total ;
        sh:name "total" ;
        sh:datatype xsd:decimal ;
        rdfs:comment "Summed amount" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:cnt ;
        sh:name "cnt" ;
        sh:datatype xsd:integer ;
        rdfs:comment "Row count" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:band_total ;
        sh:name "band_total" ;
        sh:datatype xsd:decimal ;
        rdfs:comment "Band level total" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:segment_name ;
        sh:name "segment_name" ;
        sh:datatype xsd:string ;
        rdfs:comment "Segment display name" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:dt ;
        sh:name "dt" ;
        sh:datatype xsd:string ;
        rdfs:comment "Partition date" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:dt ;
        rdfs:comment "partition (proven) on dt" ;
        sl:constraint "cst:005" ;
        sl:tier "proven"
    ] ;
    sl:compositeKey [
        sl:constraint "cst:004" ;
        sl:keyColumn "segment", "band", "dt" ;
        rdfs:comment "unique_per (proven) on segment, band, dt; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:tier "proven"
    ] ;
    sl:candidateKey [
        sl:keyColumn "segment", "band" ;
        rdfs:comment "candidate key; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:tier "proven"
    ] .

sl:mart_user_namesShape
    a sh:NodeShape ;
