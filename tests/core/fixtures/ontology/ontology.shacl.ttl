        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:dt ;
        sh:name "dt" ;
        sh:datatype xsd:string ;
        rdfs:comment "Partition date" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:dt ;
        rdfs:comment "partition (proven) on dt" ;
        sl:constraint "cst:005" ;
        sl:tier "proven"
    ] ;
    sl:compositeKey [
        sl:constraint "cst:004" ;
        sl:keyColumn "segment", "band", "dt" ;
        rdfs:comment "unique_per (proven) on segment, band, dt; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:tier "proven"
    ] ;
    sl:candidateKey [
        sl:keyColumn "segment", "band" ;
        rdfs:comment "candidate key; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:evidenceCount 1 ;
        sl:evidenceTask "golden_grouped_dedup_join" ;
        sl:tier "proven"
    ] .

