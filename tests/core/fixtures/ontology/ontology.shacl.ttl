@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sl: <https://example.org/scope-lineage/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Exported from an ontology candidate over a SQL corpus. The base IRI is a placeholder;
# every shape carries sl:tier for the assertion it came from -- read it before validating.

sl:Entity
    a rdfs:Class ;
    rdfs:subClassOf sl:Concept ;
    rdfs:label "Entity" ;
    rdfs:comment "a business thing that persists through time (a continuant)" ;
    sl:conceptKind "entity" ;
    sl:category "continuant" .

sl:Event
    a rdfs:Class ;
    rdfs:subClassOf sl:Concept ;
    rdfs:label "Event" ;
    rdfs:comment "something that happened to the business (an occurrent)" ;
    sl:conceptKind "event" ;
    sl:category "occurrent" .

sl:Summary
    a rdfs:Class ;
    rdfs:subClassOf sl:Concept ;
    rdfs:label "Summary" ;
    rdfs:comment "a figure aggregated over entities or events (an aggregate)" ;
    sl:conceptKind "summary" ;
    sl:category "aggregate" .

sl:dim_channelShape
    a sh:NodeShape ;
    sh:targetClass sl:dim_channel ;
    rdfs:label "dim.channel" ;
    rdfs:comment "渠道维表（合成）" ;
    sl:domain "渠道域" ;
    sl:represents "concept:channel (primary)" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:channel_code ;
        sh:name "channel_code" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:channel_name ;
        sh:name "channel_name" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sl:candidateKey [
        sl:keyColumn "channel_code" ;
        rdfs:comment "candidate key; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:evidenceCount 2 ;
        sl:evidenceTask "golden_commented_insert" ;
        sl:tier "hypothesis"
    ] .

sl:dim_segment_dimShape
    a sh:NodeShape ;
    sh:targetClass sl:dim_segment_dim ;
    rdfs:label "dim.segment_dim" ;
    sl:represents "concept:table:dim_segment_dim (primary)" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:segment ;
        sh:name "segment" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:segment_name ;
        sh:name "segment_name" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:updated_at ;
        sh:name "updated_at" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sl:multiplicity [
        sl:column "segment" ;
        rdfs:comment "multiple_rows_per_key (implied) on segment; evidence_count 1, first task golden_grouped_dedup_join" ;
        sl:tier "implied"
    ] .

sl:mart_channel_summaryShape
    a sh:NodeShape ;
    sh:targetClass sl:mart_channel_summary ;
    rdfs:label "mart.channel_summary" ;
    sl:represents "concept:table:mart_channel_summary (primary)" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:customer_id ;
        sh:name "customer_id" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:channel_name ;
        sh:name "channel_name" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:total_amount ;
        sh:name "total_amount" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:channel_name ;
        sh:in ( "OFFLINE" "ONLINE" ) ;
        rdfs:comment "in_set (proven) on channel_name; observed values: OFFLINE, ONLINE" ;
        sl:constraint "cst:002" ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:dt ;
        rdfs:comment "partition (proven) on dt" ;
        sl:constraint "cst:003" ;
        sl:tier "proven"
    ] ;
    sl:compositeKey [
        sl:constraint "cst:001" ;
        sl:keyColumn "customer_id", "channel_name", "dt" ;
        rdfs:comment "unique_per (proven) on customer_id, channel_name, dt; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:tier "proven"
    ] ;
    sl:candidateKey [
        sl:keyColumn "customer_id", "channel_name" ;
        rdfs:comment "candidate key; SHACL core has no composite uniqueness constraint, so this is an annotation rather than a validated shape" ;
        sl:evidenceCount 2 ;
        sl:evidenceTask "golden_commented_insert" ;
        sl:tier "proven"
    ] .

