    ] .

sl:ods_channel_eventShape
    a sh:NodeShape ;
    sh:targetClass sl:ods_channel_event ;
    rdfs:label "ods.channel_event" ;
    rdfs:comment "渠道事件明细（合成）" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:customer_id ;
        sh:name "customer_id" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:channel_code ;
        sh:name "channel_code" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:amount ;
        sh:name "amount" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:status ;
        sh:name "status" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:status ;
        rdfs:comment "in_set (hypothesis) on status; observed values: ACTIVE; the SQL did not prove the set closed" ;
        sl:constraint "cst:006" ;
        sl:tier "hypothesis"
    ] ;
    sh:property [
        sh:path sl:rel_001 ;
        sh:class sl:dim_channel ;
        sh:maxCount 1 ;
        sl:relation "rel:001" ;
        sl:claim "many_to_one_assumed" ;
        sl:taskCount 2 ;
        sl:tier "hypothesis"
    ] .

sl:ods_events_aShape
    a sh:NodeShape ;
    sh:targetClass sl:ods_events_a ;
    rdfs:label "ods.events_a" ;
    sl:tier "proven" ;
    sh:property [
        sh:path sl:segment ;
        sh:name "segment" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:amount ;
        sh:name "amount" ;
        sh:datatype xsd:string ;
        sl:tier "proven"
    ] ;
    sh:property [
        sh:path sl:rel_002 ;
        sh:class sl:dim_segment_dim ;
        sl:relation "rel:002" ;
        sl:claim "one_to_many" ;
        sl:taskCount 1 ;
        sl:tier "implied"
    ] ;
    sh:property [
        sh:path sl:rel_003 ;
        sh:class sl:ods_events_b ;
        sl:relation "rel:003" ;
        sl:claim "unknown" ;
        sl:taskCount 1 ;
        sl:tier "implied"
    ] .

